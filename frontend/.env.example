# 프론트 환경변수 (docs/11 §5) — VITE_ 접두사는 번들에 노출되므로 공개 가능 값만.
# 로컬 개발 시 이 파일을 .env.local 로 복사해서 사용한다.
# 개발 모드에서는 비워 두어도 http://localhost:8080/api/v1 로 폴백한다.
# 프로덕션 빌드에서는 반드시 지정한다(미지정 시 상대경로 /api/v1 사용).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# 로그인 화면의 '데모 계정' 버튼 노출 여부. 개발 모드 기본 true, 프로덕션 빌드 기본 false.
# 공개 데모 배포에서 의도적으로 보여줄 때만 true 로 지정한다.
# VITE_DEMO_LOGIN=false
