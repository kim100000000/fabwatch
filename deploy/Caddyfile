# FabWatch 단일 도메인 프록시 설정 (docs/13 §11~§12)
#
#   브라우저 ──HTTPS──> Caddy ─┬─ /api/v1/stream/*  → backend:8080 (SSE, 버퍼링 off·압축 없음)
#                              ├─ /api/*            → backend:8080 (REST)
#                              ├─ /healthz          → backend:8080/actuator/health (외부 모니터링용)
#                              └─ 그 외              → /srv 정적 파일 (SPA fallback → index.html)
#
# 사이트 주소는 환경변수 DOMAIN 으로 정한다 (docker-compose.prod.yml 이 .env.prod 에서 주입).
#   DOMAIN=fabwatch.example.com   → 자동 HTTPS(Let's Encrypt) + 80→443 리다이렉트
#   DOMAIN=:80                    → HTTP 전용. 도메인 없이 EC2 IP 로 먼저 띄울 때 (인증서 발급 없음, 평문 통신 주의)
#   DOMAIN=<IP-대시표기>.sslip.io → 도메인 없이도 진짜 HTTPS 가 필요할 때의 임시 대안 (docs/13 §11)
{
	# 관리 API(:2019)는 컨테이너 안에서도 쓰지 않으므로 끈다
	admin off

	servers {
		timeouts {
			# slowloris 방어. write 타임아웃은 SSE 장시간 연결 때문에 설정하지 않는다.
			read_header 10s
			read_body 30s
			idle 2m
		}
	}

	# Caddy 자체 로그(업스트림 오류 등)에도 요청 URI 가 실린다 → SSE 토큰 쿼리 마스킹 (docs/11 §4)
	log {
		output stderr
		format filter {
			wrap console
			request>uri query {
				replace token REDACTED
			}
		}
	}
}

# ----------------------------------------------------------------------------
# 스니펫
# ----------------------------------------------------------------------------

# 보안 헤더 (docs/11 §4, docs/13 §12)
#  - CSP: index.html 이 jsDelivr(Pretendard)·Google Fonts(JetBrains Mono)를 쓰므로 해당 출처만 예외 허용.
#    React 의 style prop 은 CSSOM 으로 적용되어 'unsafe-inline' 이 필요 없다(실측 확인, docs/13 §12).
#    upgrade-insecure-requests 는 넣지 않는다 — HTTP 전용 모드(DOMAIN=:80)에서 리소스가 깨진다.
#  - HSTS 는 HTTPS 응답에서만 브라우저가 반영한다. includeSubDomains/preload 는 같은 상위 도메인의 다른 서비스에 영향이 있어 쓰지 않는다.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}

# 백엔드로 넘기는 클라이언트 식별 헤더 (스푸핑 방지, docs/13 §12 · docs/11 §4)
#  백엔드는 server.forward-headers-strategy=native(Tomcat RemoteIpValve) 로 실제 IP 를 복원한다(레이트 리밋 키): 요청을 직접 보낸 홉이
#  내부 프록시 대역(docker 브리지 포함)일 때만 X-Forwarded-For 를 신뢰하고 오른쪽부터 첫 비신뢰 주소를 클라이언트로 본다 → 클라이언트가
#  왼쪽에 끼워 넣은 위조 값은 무시된다(Caddy 가 덮어쓰든 덧붙이든 안전). 아래 설정은 그 위에 얹는 **심층 방어**다:
#  Caddy 는 신뢰 프록시(trusted_proxies)가 아닌 상대가 보낸 X-Forwarded-For/-Proto/-Host 를 버리고 자신이 본 접속 정보 한 개로 "덮어쓴다"
#  (Caddy 2.5+ 기본 동작이며, 그래서 아래에서 header_up 으로 다시 설정하지 않는다). 최전방(엣지)일 때만 맞는 전제이므로 trusted_proxies 는 설정하지 않는다.
#  표준 Forwarded 헤더와 경로를 바꿀 수 있는 X-Forwarded-Prefix 등은 백엔드로 보내지 않는다(전략을 바꿔도 안전하도록 제거).
#  앞단에 ALB/CloudFront 등을 추가하면 이 전제가 깨진다 → 전역 옵션 servers { trusted_proxies ... } 설정이 필요하다.
(proxy_headers) {
	header_up -Forwarded
	header_up -X-Forwarded-Port
	header_up -X-Forwarded-Prefix
	header_up -X-Real-IP
}

# ----------------------------------------------------------------------------
# 메인 사이트
# ----------------------------------------------------------------------------
{$DOMAIN} {
	# 접근 로그(JSON, stdout → docker logs). SSE 용 ?token= 쿼리는 값을 마스킹한다. Authorization/Cookie 헤더는 Caddy 가 기본으로 REDACTED 처리한다.
	log {
		output stdout
		format filter {
			wrap json
			request>uri query {
				replace token REDACTED
			}
		}
	}

	import security_headers

	# SSE: 버퍼링 끄고(flush_interval -1) 압축하지 않는다. 읽기/응답 타임아웃을 두지 않아 장시간 연결이 유지된다
	# (백엔드가 30초마다 heartbeat 전송). 재시도(lb_try_*)도 걸지 않는다.
	handle /api/v1/stream/* {
		reverse_proxy backend:8080 {
			flush_interval -1
			import proxy_headers
		}
	}

	# REST API
	#  - 본문 상한: 백엔드(MAX_REQUEST_BYTES=1MiB)가 JSON 에러(413 PAYLOAD_TOO_LARGE)를 주도록 Caddy 는 2MiB 로 느슨하게 둔 바깥 방어선이다.
	#  - lb_try_duration: 백엔드 재기동 중 연결 거부(dial 실패)를 최대 5초 재시도해 배포 순간의 502 를 줄인다(요청 전송 전 실패만 재시도되므로 POST 도 안전).
	handle /api/* {
		request_body {
			max_size 2MiB
		}
		encode zstd gzip
		reverse_proxy backend:8080 {
			lb_try_duration 5s
			lb_try_interval 250ms
			import proxy_headers
		}
	}

	# 외부 업타임 모니터용 헬스 (백엔드 /actuator/health 의 UP/DOWN 만 노출; 그 외 /actuator/* 는 외부에 열지 않는다)
	handle /healthz {
		rewrite * /actuator/health
		reverse_proxy backend:8080 {
			import proxy_headers
		}
	}

	# 해시 파일명 정적 자산: 1년 immutable. 없는 파일은 index.html 로 폴백하지 않고 404 (오래된 해시가 HTML 로 캐시되는 사고 방지)
	handle /assets/* {
		root * /srv
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA: 파일이 없으면 index.html (딥링크 /equipment/1 새로고침). index.html 은 항상 재검증(no-cache)해서 배포 직후 새 해시를 받는다.
	handle {
		root * /srv
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# ----------------------------------------------------------------------------
# 컨테이너 내부 헬스체크 전용 (포트 8081 은 compose 에서 publish 하지 않는다)
# ----------------------------------------------------------------------------
http://:8081 {
	respond /ping "ok" 200
}
