# FabWatch 운영(EC2 + docker compose) 환경변수 템플릿 — docs/13 §3
#
#   cp deploy/env.prod.example .env.prod && chmod 600 .env.prod   (.env.prod 는 .gitignore 로 커밋 차단됨)
#   docker compose 는 --env-file .env.prod 로 읽는다 (scripts/deploy.sh 가 처리).
#   (이 템플릿은 루트 .env.prod.example 로 복사해 두어도 된다 — .gitignore 가 *.example 은 허용한다)
#
# 이 파일은 "운영용"이다. 로컬 개발용 .env.example(MySQL 포트 등)과는 별개이며 서로 읽지 않는다.
# 실제 비밀값을 이 .example 파일에 절대 적지 않는다 (CLAUDE.md 보안 규칙).
#
# 값 작성 규칙: 따옴표 없이 한 줄. 비밀번호에 $ # ' " 공백이 들어가면 compose 가 잘못 해석하므로
#   openssl rand -hex 24 처럼 영숫자만 나오는 생성 방법을 쓴다. (사람이 정하는 관리자 비밀번호만 예외 — 아래 참고)

# ---------------------------------------------------------------- 접속 주소
# 공개 도메인. 도메인이 있으면 자동 HTTPS(Let's Encrypt) — DNS A 레코드가 이 EC2 의 탄력적 IP 를 가리켜야 한다.
#   DOMAIN=fabwatch.example.com
# 도메인 없이 IP 로 먼저 띄울 때(HTTP 전용, 평문 — 비밀번호가 평문으로 오가므로 시연·점검용으로만):
#   DOMAIN=:80
# 도메인 없이 HTTPS 가 필요할 때 임시 대안: 탄력적 IP 를 대시로 써서 sslip.io 호스트명 사용 (docs/13 §11)
#   DOMAIN=203-0-113-10.sslip.io
DOMAIN=

# 브라우저가 접속하는 Origin (스킴 포함, 경로·슬래시 없음). 백엔드 CORS 허용 목록으로 쓰인다.
#   HTTPS 도메인:  https://fabwatch.example.com
#   IP 로 HTTP:    http://203.0.113.10
PUBLIC_ORIGIN=

# ---------------------------------------------------------------- MySQL (compose 내부 전용, 호스트 포트 없음)
MYSQL_DATABASE=fabwatch
MYSQL_USER=fabwatch
# 생성: openssl rand -hex 24
MYSQL_PASSWORD=
# 생성: openssl rand -hex 24   (백업 스크립트가 사용 — 앱은 쓰지 않는다)
MYSQL_ROOT_PASSWORD=

# ---------------------------------------------------------------- 백엔드 필수 시크릿
# 32바이트 이상 필수. 생성: openssl rand -base64 48
# 바꾸면 발급된 모든 토큰이 무효가 되어 전원 재로그인한다. 분실해도 DB 는 영향 없음.
JWT_SECRET=

# 최초 기동 때 users 테이블이 비어 있으면 이 계정을 ADMIN 으로 1회 생성한다(운영에는 시드 계정/데모 비밀번호가 없다).
# 비밀번호 정책: 8자 이상 + 영문/숫자 포함 (docs/11 §2). 첫 배포에는 필수 — 최초 로그인 뒤에는 .env.prod 에서 지워도 된다
# (users 가 비어 있지 않으면 어차피 무시된다). 비밀번호에 $ # 따옴표를 넣지 말 것.
# 이메일은 추측 불가능한 값으로(admin@·root@ 금지): 공개 데모에서는 5회 오답 잠금(DoS) 표적이 된다 (docs/13 §4.4). 예: ops-7f3a91@example.com
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=운영 관리자

# ---------------------------------------------------------------- AI 리포트 (Claude API, 백엔드 경유만)
# 키가 없으면 리포트 생성이 FAILED 로 끝날 뿐 다른 기능은 정상 (자동 mock 전환 없음).
# 키는 https://console.anthropic.com 에서 발급. 월 한도(Spend limit)를 콘솔에서 꼭 걸어 둘 것.
ANTHROPIC_API_KEY=
# claude(기본) | mock. mock 은 [MOCK] 표기가 붙은 가짜 결과 — 키 없이 흐름만 시연할 때 명시적으로 지정.
AI_PROVIDER=claude

# ---------------------------------------------------------------- 공개 데모 (옵트인 — 기본은 전부 꺼짐)
# 운영 DB 는 시드가 없어 비어 있다. 공개 데모를 하려면 아래 세 값을 함께 켠다 (docs/13 §4.4).
#   1) DEMO_DATA_ENABLED=true            백엔드가 CELL-1 라인·설비 5대·센서·PM 데모 데이터를 만든다(멱등 — 여러 번 켜도 중복 없음).
DEMO_DATA_ENABLED=false
#   2) DEMO_ACCOUNTS_PASSWORD=<공개 비밀번호>   engineer@fabwatch.dev / tech@fabwatch.dev 두 계정이 이 비밀번호로 생성된다. 비어 있으면 계정 없음.
#      ★ 이 값은 프론트 빌드에도 같은 변수로 주입되어 번들(공개 JS)에 노출된다 → 시크릿이 아니다. ADMIN 비밀번호와 반드시 다르게.
#      생성: openssl rand -hex 6   (영숫자 12자리. $ # 따옴표 금지. 8자 이상 영문+숫자 정책 충족)
#      ADMIN 데모 계정은 만들지 않는다 — ADMIN 은 위 BOOTSTRAP 계정만 비공개로 보유.
#      (키를 비워 둔 채 두지 말고 쓸 때만 주석을 풀 것 — 빈 문자열이 전달되는 것을 피한다)
# DEMO_ACCOUNTS_PASSWORD=
#   3) VITE_DEMO_LOGIN=true               로그인 화면에 ENGINEER/TECHNICIAN '데모 계정' 버튼 노출(ADMIN 버튼 없음).
#      DEMO_ACCOUNTS_PASSWORD 가 비어 있으면 true 여도 버튼이 나오지 않는다. 값을 바꾸면 이미지 재빌드(deploy.sh)가 필요하다.
VITE_DEMO_LOGIN=false

# ---------------------------------------------------------------- 선택 튜닝 (필요할 때만 주석 해제 — 안 적으면 백엔드 기본값, docs/13 §3 표)
# 값을 적으면 backend 컨테이너로 그대로 전달된다. 키만 적고 비워 두면(KEY=) "빈 문자열"이 전달되므로 쓰지 않을 키는 주석 상태로 둔다.
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60 -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError
# AI_MODEL=claude-sonnet-5-5
# AI_DAILY_QUOTA=20             # 하루(KST) 전체 AI 호출 상한
# AI_USER_DAILY_QUOTA=5         # 사용자별 하루 상한(전체 상한과 함께 적용 — 공개 데모 계정 한 개가 전체를 소진하지 못하게)
# AI_TIMEOUT_SECONDS=60
# RATE_LIMIT_AUTH_PER_MINUTE=30
# SSE_MAX_CONNECTIONS=200
# SSE_MAX_PER_USER=5
# DB_POOL_MAX=10
# SIMULATOR_ENABLED=true          # 센서 시뮬레이터(데모 데이터 생성). 끄려면 false
# SIMULATOR_DEMO_DURATION_MIN=2

# ---------------------------------------------------------------- 배포 스크립트 전용 (선택)
# 백업 보관 일수 / 백업 폴더 (scripts/backup-mysql.sh)
# BACKUP_KEEP_DAYS=7
# BACKUP_DIR=/opt/fabwatch/backups
