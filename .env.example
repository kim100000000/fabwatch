# 백엔드 (docs/13 §3) — 실값은 .env 또는 배포 플랫폼 환경변수에만. 이 파일은 키만 커밋.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://localhost:3307/fabwatch?useSSL=false&serverTimezone=UTC
DB_USERNAME=fabwatch
DB_PASSWORD=fabwatch_local
JWT_SECRET=
JWT_ACCESS_EXP_MIN=30
JWT_REFRESH_EXP_DAYS=14
# 회전 직후 직전 Refresh 토큰 허용 시간(초, 병렬 갱신 대비). 0이면 유예 없음
JWT_REFRESH_GRACE_SECONDS=10
# /auth/login·/auth/refresh IP x 엔드포인트별 분당 허용 횟수 (초과 429)
RATE_LIMIT_AUTH_PER_MINUTE=30
# 요청 본문 상한(바이트, 기본 1MB, 초과 413)
MAX_REQUEST_BYTES=1048576
# SSE 전체/사용자별 동시 연결 상한
SSE_MAX_CONNECTIONS=200
SSE_MAX_PER_USER=5
# SSE 비동기 전송(운영은 true 유지) / 구독자별 대기 큐 / 전송 지연 허용(ms) / 전송 스레드 수
SSE_ASYNC=true
SSE_QUEUE_CAPACITY=100
SSE_SEND_TIMEOUT_MS=5000
SSE_SENDER_THREADS=8
# 센서 원본 7일 삭제 배치: 트랜잭션당 행 수 / 청크 사이 대기(ms)
SENSOR_PURGE_CHUNK_SIZE=10000
SENSOR_PURGE_CHUNK_PAUSE_MS=100
# 센서 이력 조회 상한: 최대 기간(일) / 센서당 최대 포인트(초과 구간은 5분/1시간 버킷으로 다운샘플링)
SENSOR_QUERY_MAX_RANGE_DAYS=31
SENSOR_QUERY_MAX_POINTS=20000
# 시뮬레이터 시나리오 자동 만료: DRIFT plateau 유지(분) / STEP/SPIKE 최대 수명(분)
SIMULATOR_PLATEAU_HOLD_MIN=5
SIMULATOR_MAX_LIFETIME_MIN=30
# DB 커넥션 풀 최대 수 / 대기 상한(ms) / graceful shutdown 대기
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT=20s
ANTHROPIC_API_KEY=
# claude(기본) | mock — mock은 외부 호출 없이 템플릿 리포트(명시 설정 시에만, 키가 없다고 자동 mock 안 됨)
AI_PROVIDER=claude
AI_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=4096
AI_EFFORT=low
AI_TIMEOUT_SECONDS=60
AI_DAILY_QUOTA=20
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 프론트 (Vite) — VITE_ 접두사는 번들에 노출되므로 공개 가능 값만
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_SSE_BASE_URL=http://localhost:8080/api/v1
